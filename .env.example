# HALOStack Environment Variables
# Generate secrets with: openssl rand -base64 32
# Do NOT use the placeholder values below in a real deployment.

## Database
POSTGRES_USER=halostack
POSTGRES_PASSWORD=generate-a-strong-postgres-password
POSTGRES_DB=halostack

## Redis / Valkey (required — job queue + rate limits + PTY tickets)
REDIS_PASSWORD=generate-a-strong-redis-password

## Web (Next.js)
# For local-dev without Docker publishing PgBouncer, use a tunnel or compose exec.
DATABASE_URL=postgresql://halostack:CHANGE_ME@localhost:6432/halostack
AUTH_SECRET=generate-a-random-string-at-least-32-chars-xx
AUTH_URL=http://localhost:8040
INTERNAL_AGENT_SECRET=generate-a-random-string-at-least-32-chars-yy
WS_TOKEN_SECRET=generate-a-random-string-at-least-32-chars-zz
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379
MASTER_SECRET=generate-a-random-string-at-least-32-chars-aa
BLIND_INDEX_SECRET=generate-a-random-string-at-least-32-chars-bb
WS_PUBLIC_URL=ws://localhost:8080
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

## SSH Agent
MASTER_SECRET_PREVIOUS=
SSH_CONCURRENCY=10
SSH_POOL_IDLE_TIMEOUT_MS=300000
JOB_TIMEOUT_MS=60000
STDOUT_CAP_BYTES=262144
HEALTH_CHECK_INTERVAL_MS=300000
JOB_RETENTION_MONTHS=6
LOG_LEVEL=info

## Observability
GRAFANA_ADMIN_PASSWORD=generate-a-strong-grafana-password
